# =================================================================
# SMARTCITY PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER & DATABASE CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=smartcity_super_secret_jwt_key_2026
JWT_EXPIRE=7d

# Primary MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_city
DB_PORT=3306

# SQLite Fallback (Optional for local/serverless testing)
# DB_DIALECT=sqlite

# -----------------------------------------------------------------
# 2. REAL DUAL-CHANNEL OTP CONFIGURATION
# -----------------------------------------------------------------

# --- A. SMS PROVIDER CONFIGURATION (Fast2SMS / Twilio / MSG91) ---
# Fast2SMS (Default Indian SMS Gateway): Obtain API key from https://www.fast2sms.com/
SMS_PROVIDER_API_KEY=your_fast2sms_api_key_here
SMS_PROVIDER_SENDER_ID=SMRTCY
SMS_PROVIDER_BASE_URL=https://www.fast2sms.com/dev/bulkV2

# Alternative: Twilio Configuration (if using Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# --- B. EMAIL PROVIDER CONFIGURATION (SMTP / Gmail / SendGrid / AWS SES) ---
# For Gmail SMTP: Generate App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_official_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM="SmartCity Municipal Portal" <no-reply@smartcity.gov.in>

# --- C. OTP SECURITY POLICY SETTINGS ---
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------
# 3. FRONTEND DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------
# For Localhost: http://localhost:5000
# For Vercel Production: Leave empty or set to /api
REACT_APP_API_URL=
