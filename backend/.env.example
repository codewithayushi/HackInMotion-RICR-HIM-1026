# SMARTCITY BACKEND ENVIRONMENT CONFIGURATION

PORT=5000
NODE_ENV=production
JWT_SECRET=smartcity_super_secret_jwt_key_2026

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_city

# SMS Gateway (Fast2SMS / Twilio)
SMS_PROVIDER_API_KEY=your_fast2sms_api_key_here
SMS_PROVIDER_SENDER_ID=SMRTCY
SMS_PROVIDER_BASE_URL=https://www.fast2sms.com/dev/bulkV2

# SMTP Email Gateway (Nodemailer / Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM="SmartCity Municipal Portal" <no-reply@smartcity.gov.in>

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
